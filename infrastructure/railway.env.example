# Railway service reference values. Configure these in the Railway dashboard;
# do not copy real secrets into this file.

# goldie-api
DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_SECRET=generate-a-long-random-secret
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD=generate-a-strong-random-password
AGENT_SERVICE_TOKEN=generate-a-long-random-agent-token
CORS_ORIGINS=https://<exact-goldie-web-railway-domain>
QUOTE_RETENTION_DAYS=30
SHADOW_NOTIONAL_BALANCE=10000
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# goldie-optuna-worker
# Configure these as Railway reference variables on the worker service.
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}
# DB_POOL_SIZE=2
# DB_MAX_OVERFLOW=0

# goldie-market-data-collector
# GOLDIE_API_URL=https://<internal-or-public-goldie-api-domain>
# GOLDIE_AGENT_TOKEN=use-the-same-value-as-AGENT_SERVICE_TOKEN
# GOLDIE_OANDA_API_TOKEN=replace-with-oanda-practice-token
# GOLDIE_OANDA_ACCOUNT_ID=replace-with-oanda-practice-account-id
# GOLDIE_OANDA_REST_URL=https://api-fxpractice.oanda.com
# GOLDIE_OANDA_STREAM_URL=https://stream-fxpractice.oanda.com

# goldie-web (build-time variables)
# NEXT_PUBLIC_API_URL=https://<exact-goldie-api-railway-domain>
# NEXT_PUBLIC_WS_URL=wss://<exact-goldie-api-railway-domain>
